/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "bip-angular": ["./dist/bip-angular"],
      "@bip-design-systems/angular/core": ["./projects/bip-angular/core/src/public-api.ts"],
      "@bip-design-systems/angular/container": ["./projects/bip-angular/container/index.ts"],
      "@bip-design-systems/angular/stack": ["./projects/bip-angular/stack/index.ts"],
      "@bip-design-systems/angular/grid": ["./projects/bip-angular/grid/index.ts"],
      "@bip-design-systems/angular/divider": ["./projects/bip-angular/divider/index.ts"],
      "@bip-design-systems/angular/text": ["./projects/bip-angular/text/index.ts"],
      "@bip-design-systems/angular/heading": ["./projects/bip-angular/heading/index.ts"],
      "@bip-design-systems/angular/link": ["./projects/bip-angular/link/index.ts"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/bip-angular/tsconfig.lib.json"
    },
    {
      "path": "./projects/bip-angular/tsconfig.spec.json"
    }
  ]
}
