/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    "src/test-setup.ts",
    "core/src/**/*.d.ts",
    "core/src/**/*.spec.ts",
    "testing/**/*.ts",
    "container/**/*.ts",
    "stack/**/*.ts",
    "grid/**/*.ts",
    "text/**/*.ts",
    "heading/**/*.ts",
    "divider/**/*.ts",
    "link/**/*.ts",
    "spinner/**/*.ts",
    "skeleton/**/*.ts",
    "badge/**/*.ts",
    "avatar/**/*.ts",
    "progress-bar/**/*.ts",
    "empty-state/**/*.ts",
    "card/**/*.ts",
    "stats-card/**/*.ts",
    "alert/**/*.ts",
    "button/**/*.ts",
    "input/**/*.ts"
  ]
}
