/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "core/src/**/*.ts",
    "container/**/*.ts",
    "stack/**/*.ts",
    "grid/**/*.ts",
    "text/**/*.ts",
    "heading/**/*.ts",
    "divider/**/*.ts",
    "link/**/*.ts",
    "spinner/**/*.ts",
    "skeleton/**/*.ts",
    "badge/**/*.ts",
    "avatar/**/*.ts",
    "progress-bar/**/*.ts",
    "empty-state/**/*.ts",
    "card/**/*.ts",
    "stats-card/**/*.ts",
    "alert/**/*.ts",
    "button/**/*.ts",
    "input/**/*.ts",
    "textarea/**/*.ts",
    "checkbox/**/*.ts",
    "radio/**/*.ts",
    "toggle/**/*.ts",
    "select/**/*.ts",
    "number-input/**/*.ts",
    "search-input/**/*.ts",
    "slider/**/*.ts",
    "file-upload/**/*.ts",
    "modal/**/*.ts",
    "confirm-dialog/**/*.ts",
    "drawer-panel/**/*.ts",
    "toast/**/*.ts",
    "tooltip/**/*.ts",
    "popover/**/*.ts",
    "dropdown/**/*.ts",
    "timeline/**/*.ts",
    "breadcrumb/**/*.ts",
    "pagination/**/*.ts",
    "tabs/**/*.ts",
    "accordion/**/*.ts",
    "stepper/**/*.ts",
    "navbar/**/*.ts",
    "sidebar/**/*.ts",
    "multi-select/**/*.ts",
    "date-picker/**/*.ts",
    "date-range-picker/**/*.ts"
  ],
  "exclude": ["**/*.spec.ts", "**/*.stories.ts"]
}
