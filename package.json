{
  "name": "bip-design-system-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build bip-angular",
    "watch": "ng build bip-angular --watch --configuration development",
    "test": "ng test bip-angular",
    "test:watch": "ng test bip-angular --watch",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json && tsc --noEmit -p visual/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "storybook": "ng run bip-angular:storybook",
    "build-storybook": "ng run bip-angular:build-storybook",
    "changeset": "changeset",
    "format": "prettier --write \"**/*.{ts,html,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,html,js,json,css,md}\"",
    "test:visual:docker": "./scripts/visual-docker.sh",
    "test:e2e": "./scripts/e2e-consumer.sh",
    "lint:package": "publint dist/bip-angular && attw --pack dist/bip-angular --profile esm-only --exclude-entrypoints \"styles/*\" --ignore-rules no-resolution internal-resolution-error cjs-resolves-to-esm",
    "size": "size-limit"
  },
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^22.12.0",
    "pnpm": ">=9"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.5.2",
    "@angular-devkit/architect": "^0.2102.0",
    "@angular-devkit/build-angular": "^21.2.0",
    "@angular-devkit/core": "^21.2.0",
    "@angular/animations": "^21.2.0",
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "14.1.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/angular-vite": "^10.6.1",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "^21.4.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "2.12.0",
    "eslint-plugin-storybook": "^10.6.1",
    "http-server": "14.1.1",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "publint": "0.3.25",
    "size-limit": "14.1.0",
    "storybook": "^10.6.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.0.8",
    "vitest-axe": "^0.1.0"
  },
  "pnpm": {
    "overrides": {
      "piscina@>=5.0.0 <5.3.2": ">=5.3.2",
      "uuid@<11.1.1": ">=11.1.1"
    }
  }
}
